+static bool hasFormat(const std::vector<SDRMFormat>& formats, uint32_t drmFormat) {
+    return std::ranges::any_of(formats, [drmFormat](const auto& fmt) { return fmt.drmFormat == drmFormat; });
+}
+
+static uint32_t pickCPUCopyFormat(const std::vector<SDRMFormat>& formats) {
+    static constexpr std::array<uint32_t, 4> preferredFormats = {
+        DRM_FORMAT_XRGB8888,
+        DRM_FORMAT_ARGB8888,
+        DRM_FORMAT_XBGR8888,
+        DRM_FORMAT_ABGR8888,
+    };
+
+    for (const auto format : preferredFormats) {
+        if (hasFormat(formats, format))
+            return format;
+    }
+
+    return DRM_FORMAT_INVALID;
+}
+
+static bool copyRGBA8ToDRMDumb(SP<CBackend> backend, SP<IBuffer> dstBuffer, const std::vector<uint8_t>& srcRGBA, const Hyprutils::Math::Vector2D& size) {
+    if (!dstBuffer || !(dstBuffer->caps() & BUFFER_CAPABILITY_DATAPTR)) {
+        backend->log(AQ_LOG_ERROR, "drm: CPU copy fallback requires a destination buffer with CPU mapping");
+        return false;
+    }
+
+    auto dma = dstBuffer->dmabuf();
+    if (!dma.success || dma.strides.at(0) == 0) {
+        backend->log(AQ_LOG_ERROR, "drm: CPU copy fallback got an invalid destination dmabuf");
+        return false;
+    }
+
+    auto [dstData, dstFormat, dstLen] = dstBuffer->beginDataPtr(0);
+    if (!dstData) {
+        backend->log(AQ_LOG_ERROR, "drm: CPU copy fallback couldn't map the destination buffer");
+        return false;
+    }
+
+    const auto width      = (size_t)size.x;
+    const auto height     = (size_t)size.y;
+    const auto srcStride  = width * 4;
+    const auto dstStride  = (size_t)dma.strides.at(0);
+    const auto bytesNeeded = dstStride * height;
+
+    if (srcRGBA.size() < srcStride * height || dstLen < bytesNeeded) {
+        dstBuffer->endDataPtr();
+        backend->log(AQ_LOG_ERROR, "drm: CPU copy fallback buffer sizing mismatch");
+        return false;
+    }
+
+    auto writePixel = [&](uint8_t* dst, const uint8_t* src) {
+        switch (dstFormat) {
+            case DRM_FORMAT_XRGB8888:
+                dst[0] = src[2];
+                dst[1] = src[1];
+                dst[2] = src[0];
+                dst[3] = 0xFF;
+                return true;
+            case DRM_FORMAT_ARGB8888:
+                dst[0] = src[2];
+                dst[1] = src[1];
+                dst[2] = src[0];
+                dst[3] = src[3];
+                return true;
+            case DRM_FORMAT_XBGR8888:
+                dst[0] = src[0];
+                dst[1] = src[1];
+                dst[2] = src[2];
+                dst[3] = 0xFF;
+                return true;
+            case DRM_FORMAT_ABGR8888:
+                dst[0] = src[0];
+                dst[1] = src[1];
+                dst[2] = src[2];
+                dst[3] = src[3];
+                return true;
+            default: return false;
+        }
+    };
+
+    bool ok = true;
+    for (size_t y = 0; y < height; ++y) {
+        const auto* srcRow = srcRGBA.data() + (y * srcStride);
+        auto*       dstRow = dstData + (y * dstStride);
+        for (size_t x = 0; x < width; ++x) {
+            if (!writePixel(dstRow + x * 4, srcRow + x * 4)) {
+                ok = false;
+                break;
+            }
+        }
+        if (!ok)
+            break;
+    }
+
+    dstBuffer->endDataPtr();
+
+    if (!ok)
+        backend->log(AQ_LOG_ERROR, std::format("drm: CPU copy fallback doesn't support destination format {}", fourccToName(dstFormat)));
+
+    return ok;
+}
+
+static bool cpuCopyBlitToSecondary(SP<CBackend> logBackend, SP<IBuffer> source, SP<IBuffer> destination, SP<CDRMRenderer> primaryRenderer) {
+    if (!logBackend || !source || !destination || !primaryRenderer) {
+        if (logBackend)
+            logBackend->log(AQ_LOG_ERROR, "drm: CPU copy fallback missing source, destination, or primary renderer");
+        return false;
+    }
+
+    const auto srcDMA = source->dmabuf();
+    const auto dstDMA = destination->dmabuf();
+    if (!srcDMA.success || !dstDMA.success) {
+        logBackend->log(AQ_LOG_ERROR, "drm: CPU copy fallback requires dmabuf source and destination");
+        return false;
+    }
+
+    if (srcDMA.size != dstDMA.size) {
+        logBackend->log(AQ_LOG_ERROR, "drm: CPU copy fallback got mismatched source and destination sizes");
+        return false;
+    }
+
+    std::vector<uint8_t> rgba;
+    rgba.resize((size_t)srcDMA.size.x * (size_t)srcDMA.size.y * 4);
+    primaryRenderer->readBuffer(source, rgba);
+
+    return copyRGBA8ToDRMDumb(logBackend, destination, rgba, srcDMA.size);
+}
